# Copy to `.env` (gitignored) or set these in the service environment.
# Every one of these is OPTIONAL — the app runs without any of them.

# Login for the web UI.
# If IETT_PASS is unset the app generates a random password on first start and
# saves it to `.auth_secret` beside iett_tracker.py, so it stays the same across
# restarts. Set this explicitly if you would rather choose it yourself.
IETT_USER=bus
IETT_PASS=

# Only needed if you deliberately re-enable the remote self-update endpoint by
# setting UPDATE_ENABLED = True in the source. It is OFF by default: exposing a
# "POST me a new Python file" endpoint on a public URL is remote code execution.
# Leave this blank unless you know exactly why you want it.
IETT_UPDATE_TOKEN=
